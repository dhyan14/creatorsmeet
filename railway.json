{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile.codeserver"
    },
    "deploy": {
        "startCommand": "code-server --bind-addr 0.0.0.0:$PORT --auth password",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}