FROM codercom/code-server:latest

# Set environment variables
ENV PASSWORD=${PASSWORD:-creatorsmeet2024}

# Create config that uses PORT from environment
RUN mkdir -p /home/coder/.config/code-server && \
    echo "bind-addr: 0.0.0.0:\${PORT:-8080}" > /home/coder/.config/code-server/config.yaml && \
    echo "auth: password" >> /home/coder/.config/code-server/config.yaml && \
    echo "password: \${PASSWORD:-creatorsmeet2024}" >> /home/coder/.config/code-server/config.yaml && \
    echo "cert: false" >> /home/coder/.config/code-server/config.yaml

EXPOSE 8080

# Start code-server (it will read config.yaml)
CMD /usr/bin/code-server
